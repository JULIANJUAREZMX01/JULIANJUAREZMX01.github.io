---
import Base from '@/layouts/Base.astro';

const WA_TXT = encodeURIComponent('Hola Julián, vi tu carta de servicios. Tengo un negocio y quiero saber qué me conviene.');
const WA = `https://wa.me/5219813344909?text=${WA_TXT}`;
const TEL = 'tel:+527721980609';
const MAIL = 'mailto:julianjuarezmx01@gmail.com?subject=Quiero cotizacion para mi negocio';

const SERVICIOS = [
  { i: '🌐', n: 'Página que vende', q: 'Sitio rápido en teléfono y computadora, con botón de WhatsApp y QR.', l: ['Diseño propio, no plantilla', 'Textos que venden', 'Google Maps y horarios', 'Lista en 7 días'], r: '$4,500 – $9,000' },
  { i: '📱', n: 'Menú digital con QR', q: 'Tu carta con fotos y precios en el teléfono del cliente. Cambias precios sin reimprimir.', l: ['QR para mesas y fachada', 'Fotos y precios editables', 'Pedidos a WhatsApp', 'Funciona sin señal'], r: '$2,500 – $4,500' },
  { i: '💬', n: 'WhatsApp automático', q: 'Asistente que responde 24/7: precios, horarios, reservas y avisos a tu celular.', l: ['Respuestas en segundos', 'Toma reservas solo', 'Avisos al dueño', 'Historial de clientes'], r: '$6,000 – $15,000' },
  { i: '🏨', n: 'Sistema de gestión', q: 'Habitaciones, mesas, limpieza, extras y reportes del día en una sola pantalla.', l: ['Control de ocupación', 'Limpieza y mantenimiento', 'Ingresos y extras', 'Reportes automáticos'], r: '$18,000 – $45,000' },
  { i: '⚙️', n: 'Automatización', q: 'Que la computadora haga lo repetitivo: reportes, inventarios, conciliaciones.', l: ['Menos trabajo manual', 'Cero errores de captura', 'Reportes solos cada día', 'Ahorro medible'], r: 'A tu medida' },
  { i: '📍', n: 'Aparecer en Google', q: 'Que te encuentren y te llamen: ficha, reseñas, QR físicos y métricas.', l: ['Ficha de Google correcta', 'QR para reseñas', 'Medición de visitas', 'Reporte mensual'], r: '$3,000 – $6,000' },
];

const PAQUETES = [
  { n: 'Presencia', p: 'Para que te encuentren y te crean', it: ['Landing de una página con tu marca', 'Menú o catálogo con QR', 'WhatsApp con mensaje listo', 'Ficha de Google y medición'], antes: '$7,900', ahora: '$3,950', d: true },
  { n: 'Vendedor', p: 'Para vender sin estar presente', it: ['Todo lo de Presencia', 'Menú digital QR actualizable', 'Asistente de WhatsApp 24/7', 'Reporte mensual de contactos'], antes: '$15,900', ahora: '$7,950' },
  { n: 'Operación', p: 'Para controlar el negocio de verdad', it: ['Todo lo de Vendedor', 'Sistema de gestión a medida', 'Automatización de reportes', 'Capacitación al equipo'], antes: '$34,900', ahora: '$17,450' },
];
---
<Base title="UNT Tecnologías Computacionales Cancún · Carta de Servicios" description="Páginas, menús QR, WhatsApp automático y sistemas de gestión para hoteles, restaurantes y negocios. Diagnóstico gratis.">
  <main class="srv">
    <section class="srv-hero">
      <div class="srv-marca-fila"><img class="srv-logo" src="/unt-logo-192.png" width="64" height="64" alt="UNT · United North Team" /><div><p class="srv-marca">UNT Tecnologías Computacionales Cancún</p><p class="srv-lema">Systems · Engineering · Development</p></div></div>
      <h1>Tu negocio,<br />en el teléfono<br />de tu cliente.</h1>
      <p class="srv-lead">Páginas que venden, menús con QR, WhatsApp que contesta solo y sistemas para controlar tu negocio. Hecho por quien ya digitalizó un hotel de 98 años en 4 días.</p>
      <div class="srv-acc">
        <a class="srv-btn" href={WA} target="_blank" rel="noopener">Escríbeme por WhatsApp</a>
        <a class="srv-btn suave" href={TEL}>Llamar ahora</a>
      </div>
      <p class="srv-promo">Promo de lanzamiento: arranque de $950 y 50% en los tres paquetes · cierra el 30 de noviembre</p>
      <p class="srv-nota">Diagnóstico gratis de 20 minutos · Cotización el mismo día · Sin mensualidades de servidor</p>
    </section>

    <section class="srv-prueba">
      <div><span class="srv-num">4 días</span><span class="srv-lab">de cero a sistema vivo</span></div>
      <div><span class="srv-num">8 QR</span><span class="srv-lab">fachada, menús y habitaciones</span></div>
      <div><span class="srv-num">5 idiomas</span><span class="srv-lab">para huéspedes de todo país</span></div>
      <div><span class="srv-num">0</span><span class="srv-lab">servidores que pagar cada mes</span></div>
    </section>

    <section class="srv-sec">
      <h2>Qué puedo hacer por ti</h2>
      <div class="srv-grid">
        {SERVICIOS.map((s) => (
          <article class="srv-card">
            <span class="srv-ico" aria-hidden="true">{s.i}</span>
            <h3>{s.n}</h3>
            <p>{s.q}</p>
            <ul>{s.l.map((x) => <li>{x}</li>)}</ul>
            <span class="srv-rango">{s.r}</span>
          </article>
        ))}
      </div>
      <p class="srv-nota">Precios en pesos. A cualquier paquete se le descuentan tus $950 de arranque. Sin mensualidad obligatoria de servidor.</p>
    </section>

    <section class="srv-sec">
      <h2>Casos reales</h2>
      <article class="srv-caso">
        <h3>Hotel Cantabria · Tulancingo</h3>
        <p>98 años de historia y cero software propio. Quedó con página en 5 idiomas, sistema de habitaciones, QR en fachada y habitaciones, y avisos automáticos al dueño en WhatsApp.</p>
        <p class="srv-dato">Resultado: 4 días de implementación · habitaciones operando en línea · 8 QR funcionando</p>
        <a class="srv-link" href="https://julianjuarezmx01.github.io/cantabria-pms-demo/" target="_blank" rel="noopener">Ver el hotel en vivo →</a>
      </article>
      <article class="srv-caso">
        <h3>Chedraui · CEDIS Cancún 427</h3>
        <p>Automatización de validaciones logísticas que antes tomaban horas de captura manual. Reportes automáticos, alertas por criticidad y cero errores de dedo.</p>
        <p class="srv-dato">Resultado: 85–90% menos tiempo · precisión arriba del 99%</p>
      </article>
    </section>

    <section class="srv-sec">
      <h2>Paquetes</h2>
      <h2 class="srv-h2">Cómo funciona el pago</h2>
      <p class="srv-sub">Sin enganches raros. Pagas poco para arrancar, pruebas un mes y decides con el sistema funcionando.</p>
      <div class="srv-pasos">
        <div class="srv-paso"><span class="srv-paso-n">1</span><h3>Arranque · $950</h3><p>Diseño, arquitectura, planeación y documentación de decisiones (ADRs). Es todo lo que se piensa antes de escribir la primera línea.</p></div>
        <div class="srv-paso"><span class="srv-paso-n">2</span><h3>Mes de prueba</h3><p>Usas el sistema un mes completo en tu negocio, con tus clientes reales. Si no te convence, ahí termina y no debes nada más.</p></div>
        <div class="srv-paso"><span class="srv-paso-n">3</span><h3>Entrega y pago final</h3><p>Si te sirve y quieres quedártelo, pagas el paquete <b>menos tus $950</b>. El proyecto queda finalizado, entregado y es tuyo.</p></div>
        <div class="srv-paso"><span class="srv-paso-n">4</span><h3>Mes 2 de soporte · $0</h3><p>Atención técnica sin costo: hasta 5 sesiones de 1 hora durante el segundo mes.</p></div>
        <div class="srv-paso"><span class="srv-paso-n">5</span><h3>Después · $1,250 por sesión</h3><p>A partir del tercer mes, cada sesión de soporte o ajuste cuesta $1,250. Sin mensualidad forzosa.</p></div>
      </div>
      <div class="srv-paqs">
        {PAQUETES.map((p) => (
          <article class={`srv-paq${p.d ? ' destacado' : ''}`}>
            {p.d && <span class="srv-tag">El más pedido</span>}
            <h3>{p.n}</h3>
            <p class="srv-para">{p.p}</p>
            <p class="srv-precio"><span class="srv-precio-antes">{p.antes}</span><b class="srv-precio-ahora">{p.ahora}</b> <span class="srv-paq-nota">MXN · promo 50%</span></p>
            <ul>{p.it.map((x) => <li>{x}</li>)}</ul>
            <span class="srv-precio">{p.pr}</span>
            <a class="srv-btn mini" href={WA} target="_blank" rel="noopener">Quiero este</a>
          </article>
        ))}
      </div>
    </section>

    <section class="srv-sec">
      <h2>Cómo trabajamos</h2>
      <ol class="srv-pasos">
        <li><b>Platicamos 20 minutos.</b> Me cuentas qué te está costando clientes o tiempo. Gratis y sin compromiso.</li>
        <li><b>Ves un prototipo en 7 días.</b> Lo pruebas en tu teléfono antes de pagar el resto.</li>
        <li><b>Lo dejo funcionando y te enseño.</b> Entrego, capacito a tu equipo y el primer mes de mantenimiento va incluido.</li>
      </ol>
      <p class="srv-garantia">Si el prototipo no te gusta, no pagas. Así de simple.</p>
    </section>

    <section class="srv-sec srv-contacto">
      <h2>Hablemos hoy</h2>
      <div class="srv-acc">
        <a class="srv-btn" href={WA} target="_blank" rel="noopener">WhatsApp directo</a>
        <a class="srv-btn suave" href={TEL}>Llamar</a>
      </div>
      <ul class="srv-datos">
        <li>WhatsApp: <b>981 334 4909</b></li>
        <li>Llamadas y SMS: <b>772 198 0609</b></li>
        <li>Correo: <a href={MAIL}>julianjuarezmx01@gmail.com</a></li>
      </ul>
      <figure class="srv-qr">
        <img src="/qr/servicios.png" alt="Código QR de la carta de servicios" width="180" height="180" loading="lazy" />
        <figcaption>Guarda esta página: escanea el QR</figcaption>
      </figure>
    </section>

    <footer class="srv-pie">
      <p>Julián Juárez Alvarado · Jefe de Sistemas y Automatización · Tulancingo, Hidalgo</p>
      <p><a href="/">Portafolio completo</a> · <a href="/cv/">Trayectoria</a></p>
    </footer>
  </main>

  <div class="srv-barra">
    <a href={WA} target="_blank" rel="noopener">WhatsApp</a>
    <a href={TEL}>Llamar</a>
  </div>

<style is:global>
.srv { --bg:#f7f2e9; --panel:#fffdf8; --line:#e3d5c3; --text:#2a1114; --muted:#7a6660;
  --oro:#8f1d2c; --teal:#1f7a4d; background:var(--bg); color:var(--text); }
body { background:#f7f2e9; }
.srv-marca { color:#8f1d2c; }
.srv h1, .srv h2 { color:#2a1114; }
.srv .srv-lead { color:#5b4640; }
.srv-btn { background:#1f7a4d; color:#fff; border-color:#1f7a4d; }
.srv-btn.suave { background:#fff; color:#8f1d2c; border-color:#8f1d2c; }
.srv-prueba, .srv-paquete, .srv-servicio { background:var(--panel); border-color:var(--line); }
.srv-num, .srv-precio-ahora { color:#8f1d2c; }
.srv-promo { display:block; background:#8f1d2c; color:#fff; text-align:center; padding:.6rem 1rem;
  border-radius:999px; font-family:var(--mono); font-size:.82rem; letter-spacing:.04em; margin:1rem auto 0; max-width:34rem; }
.srv-precio-antes { text-decoration:line-through; color:#a08d86; font-size:.95rem; margin-right:.45rem; }
.srv-barra { background:#fffdf8; border-top:1px solid #e3d5c3; }
</style>

</Base>
