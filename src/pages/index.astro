---
import Base from '@/layouts/Base.astro';
import { PROYECTOS, ESTRATOS } from '@/data/projects.ts';
import { LOGROS, PRINCIPIOS, STACK, FRASE } from '@/data/trayectoria.ts';

const evidencias = [
  ['24 oct 2026', 'Nace el PMS Cantabria: demo estática v4.4', 'Datos de ejemplo, una sola página.'],
  ['25 oct 2026', 'Cutover a producción con identidad de marca (v7)', '9 piezas gráficas vivas; reserva real verificada E2E.'],
  ['25 oct 2026', 'Diseño colonial elevado (v8) y sitio animado (v9)', 'GSAP + Lenis; 5 idiomas; accesibilidad de fábrica.'],
  ['25 oct 2026', 'Sistema físico-digital: 8 QRs verificados', 'Fachada, contacto vCard, WhatsApp, WiFi por piso y concierge.'],
  ['25 oct 2026', 'Página /confirmacion como destino de conversión', 'Lista para Google Ads y GA4 (ADR-014).'],
  ['26 oct 2026', 'Gobernanza operativa en marcha', 'ADR-015, turno semanal, auditoría de datos y CI verde.'],
];

const contactos = [
  { t: 'Correo', s: 'julianjuarezmx01@gmail.com', h: 'mailto:julianjuarezmx01@gmail.com' },
  { t: 'LinkedIn', s: '/in/julianjuarezalvarado', h: 'https://mx.linkedin.com/in/julianjuarezalvarado' },
  { t: 'GitHub', s: '@JULIANJUAREZMX01', h: 'https://github.com/JULIANJUAREZMX01' },
  { t: 'Telegram', s: 'KynicOS · operador IA', h: 'https://t.me/Kalpixk_AI_bot' },
];
---
<Base title="JAJA.DEV · Julián Juárez — Sistemas que siguen vivos" description="Portafolio de Julián Juárez Alvarado: Jefe de Sistemas & Automatización. Arquitectura DACC: sitios estáticos, datos auditables y un agente operador.">
  <header class="top">
    <div class="nav">
      <span class="marca">JAJA.DEV</span>
      <nav>
        <a href="#proyectos">Proyectos</a>
      <a href="/servicios/">Servicios</a>
        <a href="#nexus">Nexus</a>
      <a href="#metodo">Método</a>
        <a href="#evidencia">Trayectoria</a>
        <a href="#homelab">Lab</a>
      <a href="/repos/">Repos</a>
      <a href="/yo/">Yo</a>
      <a href="/kynicos/">KynicOS</a>
      <a href="/diogenes/">Diógenes</a>
      <a href="/cv/">CV</a>
      <a href="#contacto">Contacto</a>
      <a href="/cv/">CV</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <section class="hero">
      <span class="hero-badge"><span class="punto"></span> DACC · nivel E4 · 0 servidores</span>
      <h1>Código que sobrevive<br /><span class="oro">a la factura del hosting.</span></h1>
      <p class="rol">Julián Juárez Alvarado · Jefe de Sistemas &amp; Automatización</p>
      <p class="claim">
        Diseño sistemas que siguen vivos cuando nadie los mira: sitios estáticos en CDN, datos auditables en git
        y un agente de IA que despliega, mide, documenta y mantiene. Este portafolio es la demostración.
      </p>
      <div class="cta">
        <a class="btn oro" href="#proyectos">Ver proyectos</a>
        <a class="btn" href="https://julianjuarezmx01.github.io/cantabria-pms-demo/" target="_blank" rel="noopener">Caso insignia: Cantabria →</a>
      </div>
      <div class="datos">
        <div class="dato"><b data-contador="329">0</b><span>commits en el caso insignia</span></div>
        <div class="dato"><b data-contador="15">0</b><span>decisiones de arquitectura</span></div>
        <div class="dato"><b data-contador="42">0</b><span>pruebas automatizadas</span></div>
        <div class="dato"><b data-contador="0">0</b><span>servidores propios</span></div>
      </div>
    </section>

    <section class="bloque" id="proyectos">
      <p class="eyebrow">Portafolio vivo</p>
      <h2>Proyectos en operación y laboratorio</h2>
      <p class="sub">Cada tarjeta declara su estado real. Si un demo depende de una plataforma externa, se dice. La honestidad técnica es parte del producto.</p>
      <div class="proyectos">
        {PROYECTOS.map((p) => (
          <article class="proyecto">
            <div class="cab">
              <div>
                <h3>{p.nombre}</h3>
                <div class="tipo">{p.tipo}</div>
              </div>
              <span class={`semaforo ${p.estado === 'vivo' ? 'vivo' : 'repo'}`}>{p.estadoDetalle}</span>
            </div>
            <p>{p.resumen}</p>
            <div class="tags">{p.stack.map((s) => <span class="tag">{s}</span>)}</div>
            {p.metrica && <div class="metrica">{p.metrica}</div>}
            {p.enlaces.length > 0 && (
              <div class="enlaces">
                {p.enlaces.map((e) => <a href={e.href} target="_blank" rel="noopener">{e.label} ↗</a>)}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>


    <section class="bloque" id="nexus">
      <p class="kicker">Mapa semántico</p>
      <h2>El Nexus: cómo se conectan mis proyectos</h2>
      <p class="intro">No es una lista, es una red. Cada nodo es un proyecto, una tecnología o un vertical; cada hilo es lo que comparten. Arrastra, toca un nodo y mira qué se ilumina.</p>
      <div class="nexus-marco">
        <div class="nexus-leyenda">
          <span class="tag hub">Método</span>
          <span class="tag proyecto">Proyecto</span>
          <span class="tag tecnologia">Tecnología</span>
          <span class="tag vertical">Vertical</span>
        </div>
        <svg id="nexus-svg" viewBox="0 0 900 520" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Grafo semántico de proyectos, tecnologías y verticales">
          <defs>
            <radialGradient id="nexus-brillo" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#d8a558" stop-opacity="0.55" />
              <stop offset="100%" stop-color="#d8a558" stop-opacity="0" />
            </radialGradient>
          </defs>
          <g id="nexus-lienzo"></g>
        </svg>
        <p id="nexus-detalle" class="nexus-detalle">Toca o pasa el cursor por un nodo: se resaltan sus conexiones. Los nodos con flecha abren el proyecto.</p>
        <details class="nexus-lista">
          <summary>Ver las conexiones como lista (para lectores de pantalla)</summary>
          <ul>
            <li><b>Cantabria PMS</b> — Astro/CDN, QR físico, hotelería, IA agéntica, CI/CD. En producción.</li>
            <li><b>KynicOS</b> — IA agéntica, hotelería, CI/CD. Agente operador del método.</li>
            <li><b>MueveCancún</b> — Astro, Rust/WASM, transporte, CI/CD. PWA offline-first.</li>
            <li><b>Kalpixk</b> — Rust/WASM, seguridad, Python. SIEM de Blue Team.</li>
            <li><b>Nexus Concierge</b> — hotelería, IA agéntica. Patrón de automatización.</li>
            <li><b>Mis Pekes</b> — educación, Astro. En migración sin servidores.</li>
          </ul>
        </details>
      </div>
    </section>

    <section class="bloque" id="metodo">
      <p class="eyebrow">Método propio</p>
      <h2>DACC — Desarrollo Agéntico de Ciclo Cerrado</h2>
      <p class="sub">Cuatro estratos que cualquier negocio puede replicar sin depender de un servidor, un plugin o una agencia mensual.</p>
      <div class="estratos">
        {ESTRATOS.map((e) => (
          <div class="estrato">
            <span class="n">{e.n}</span>
            <h3>{e.t}</h3>
            <p>{e.d}</p>
          </div>
        ))}
      </div>
    </section>


    <section class="bloque" id="trayectoria">
      <p class="eyebrow">Antes del código público · Chedraui CEDIS Cancún 427</p>
      <h2>Logros que se miden en dinero, no en pantallas</h2>
      <p class="sub">Jefe de Sistemas en un CEDIS de 427 puertas: automatización de validación logística con ROI auditado. Este es el sustrato del portafolio.</p>
      <div class="grid logros">
        {LOGROS.map((l) => (
          <article class="card logro">
            <header>
              <h3>{l.nombre}</h3>
              <p class="mono contexto">{l.contexto}</p>
            </header>
            <div class="metricas">
              {l.metricas.map(([k, v]) => (
                <div class="metrica"><span class="valor">{v}</span><span class="etiqueta">{k}</span></div>
              ))}
            </div>
            <p>{l.detalle}</p>
          </article>
        ))}
      </div>
      <blockquote class="frase">{FRASE}</blockquote>
    </section>

    <section class="bloque" id="principios">
      <p class="eyebrow">Cómo trabajo</p>
      <h2>Tres principios, cero adornos</h2>
      <div class="grid principios">
        {PRINCIPIOS.map((p, i) => (
          <article class="card principio">
            <span class="num mono">0{i + 1}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </article>
        ))}
      </div>
      <div class="stack">
        <h3 class="mono">$ ls stack/</h3>
        {STACK.map(([cat, items]) => (
          <div class="fila-stack">
            <span class="categoria">{cat}</span>
            <div class="tags">{items.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="bloque" id="evidencia">
      <p class="eyebrow">Evidencia, no promesas</p>
      <h2>Del diagnóstico a producción en cuatro días</h2>
      <p class="sub">Cronología real del caso Cantabria, verificable en el repositorio: cada línea es un commit o un ADR.</p>
      <ul class="evidencia">
        {evidencias.map(([fecha, hito, detalle]) => (
          <li><span class="fecha">{fecha}</span><div>{hito} <span>· {detalle}</span></div></li>
        ))}
      </ul>
    </section>


    <section class="bloque" id="terminal">
      <p class="kicker">Terminal</p>
      <h2>Quién soy, en una terminal</h2>
      <div class="term">
        <div class="term-barra"><span class="punto"></span><span class="punto"></span><span class="punto"></span><em>julian@jaja-systems:~$</em></div>
        <div class="term-cuerpo mono">
          <p><span class="prompt">$</span> whoami</p>
          <p class="out">Julián Juárez Alvarado · Jefe de Sistemas &amp; Automatización</p>
          <p><span class="prompt">$</span> cat bio.txt</p>
          <p class="out">Ingeniero de sistemas especializado en automatización end-to-end de procesos logísticos. Diseño soluciones que generan ROI medible, eliminan intervención manual y sostienen operaciones a escala empresarial.</p>
          <p><span class="prompt">$</span> ls skills/</p>
          <p class="out">├── python/fastapi · react/typescript · postgresql/db2<br/>├── automatización de procesos · arquitectura de sistemas<br/>└── devops &amp; ci/cd · análisis de ROI · infraestructura</p>
          <p><span class="prompt">$</span> cat contacto.json</p>
          <p class="out">&#123; 'email': 'julianjuarezmx01@gmail.com', 'linkedin': 'julianjuarezalvarado', 'github': 'JULIANJUAREZMX01' &#125;</p>
          <p><span class="prompt">$</span> <span class="cursor">▊</span></p>
        </div>
      </div>
    </section>

    <section class="bloque" id="homelab">
      <p class="kicker">HomeLab</p>
      <h2>Donde todo se prueba antes de producción</h2>
      <p class="intro">No diseño en el aire: cada patrón que uso en clientes se valida primero en mi propio laboratorio.</p>
      <div class="lab-grid">
        <article class="panel lab-item">
          <span class="mono lab-tipo">Servidor principal</span>
          <h3>Dell PowerEdge R720</h3>
          <p class="lab-specs">2× Xeon E5-2670 · 128 GB RAM · 8 TB RAID 10</p>
          <p>Virtualización con Proxmox, contenedores Docker y pipelines de CI/CD propios.</p>
        </article>
        <article class="panel lab-item">
          <span class="mono lab-tipo">Red</span>
          <h3>UniFi Dream Machine Pro</h3>
          <p class="lab-specs">Switching 10 Gbps · IDS/IPS · VLANs segregadas</p>
          <p>Segmentación de red, monitoreo de tráfico y firewall perimetral.</p>
        </article>
        <article class="panel lab-item">
          <span class="mono lab-tipo">Almacenamiento</span>
          <h3>Synology DS920+</h3>
          <p class="lab-specs">32 TB en RAID 6 · caché SSD · 10 GbE</p>
          <p>Respaldos automatizados, versionado de datos y file server del laboratorio.</p>
        </article>
      </div>
    </section>


    <section class="bloque" id="repos-bloque">
      <p class="kicker">Todo el taller</p>
      <h2>No es una web: es un taller abierto</h2>
      <p class="intro">21 repositorios públicos documentados, más 6 de cliente bajo confidencialidad. Productos en producción, herramientas internas y experimentos, cada uno con su propio registro.</p>
      <p class="cta-row"><a class="btn" href="/repos/">Ver los 21 repositorios</a><a class="btn btn-sec" href="/diogenes/">Leer el codestyle Diógenes</a></p>
    </section>
    <section class="bloque" id="contacto">
      <p class="eyebrow">Siguiente paso</p>
      <h2>Hablemos de tu operación</h2>
      <p class="sub">Si tu negocio vive en papel, en WhatsApp o en un servidor que se cae, hay un sistema replicable esperando.</p>
      <div class="contacto">
        {contactos.map((c) => (
          <a href={c.h} target="_blank" rel="noopener"><b>{c.t}</b><span>{c.s}</span></a>
        ))}
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap fin">
      <span>© 2026 JAJA.DEV · Julián Juárez Alvarado · Tulancingo / Cancún, México</span>
      <span class="estado-vivo"><span class="punto"></span> estático · GitHub Pages · sin servidores</span>
      <span class="mono">build DACC/E4 <span id="sello"></span></span>
    </div>
  </footer>

  <script>
    import '@/client/motion.ts';
    const el = document.getElementById('sello');
    if (el) el.textContent = `· ${new Date().toISOString().slice(0, 10)}`;
  </script>
</Base>

<script>
  import "@/client/nexus.ts";
</script>
